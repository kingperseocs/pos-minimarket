enum attendance_correction_status {
  pending
  approved
  rejected
}

enum attendance_field {
  clock_in
  clock_out
}

enum attendance_status {
  open
  closed
  missing_clock_out
}

enum capture_source {
  scan
  manual
}

enum cash_movement_type {
  in
  out
}

enum cash_shift_status {
  open
  closed
  reviewed
}

enum count_item_status {
  matched
  pending
  approved
  rejected
}

enum discrepancy_status {
  open
  replenished
  credited
  written_off
  kept
  returned
}

enum location_kind {
  warehouse
  store
}

enum loyalty_movement_type {
  earn
  adjust
  reverse
}

enum payment_type {
  cash
  yape_plin
  card
}

enum purchase_order_status {
  pending
  partial
  received
  cancelled
}

enum receipt_doc_type {
  factura
  boleta
  guia
  ninguno
}

enum sale_status {
  completed
  voided
}

enum stock_movement_type {
  opening
  count_adjustment
  purchase_receipt
  transfer_out
  transfer_in
  sale
  sale_void
  waste
  supplier_return
}

enum user_role {
  admin
  cashier
  warehouse
}

enum worker_name_source {
  api
  manual
}

enum worker_pending_reason {
  new
  pin_reset
}

enum worker_status {
  pending
  active
  suspended
  rejected
}

enum worker_verification {
  none
  pin_online
  pin_offline
  dni_manual
}

table accounts {
  id_user integer [not null]
  type text [not null]
  provider text [not null]
  provider_account_id text [not null]
  refresh_token text
  access_token text
  expires_at integer
  token_type text
  scope text
  id_token text
  session_state text

  indexes {
    (provider, provider_account_id) [pk]
  }
}

table attendance_corrections {
  id_attendance_correction integer [pk, not null]
  uuid uuid [not null, unique]
  attendance_uuid uuid [not null]
  field attendance_field [not null]
  old_value "timestamp with time zone"
  new_value "timestamp with time zone" [not null]
  reason text [not null]
  id_requested_by integer [not null]
  status attendance_correction_status [not null, default: 'pending']
  id_reviewed_by integer
  reviewed_at "timestamp with time zone"
  review_note text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    attendance_uuid [name: 'attendance_corrections_record_idx']
    status [name: 'attendance_corrections_status_idx']
  }
}

table attendance_records {
  id_attendance integer [pk, not null]
  uuid uuid [not null, unique]
  id_user integer [not null]
  work_date date [not null]
  clock_in_at "timestamp with time zone" [not null]
  clock_in_device_at "timestamp with time zone"
  clock_in_received_at "timestamp with time zone" [not null, default: `now()`]
  clock_out_at "timestamp with time zone"
  clock_out_device_at "timestamp with time zone"
  clock_out_received_at "timestamp with time zone"
  scheduled_start "timestamp with time zone"
  scheduled_end "timestamp with time zone"
  tolerance_min integer
  late_minutes integer [not null, default: 0]
  early_leave_minutes integer [not null, default: 0]
  status attendance_status [not null, default: 'open']
  offline boolean [not null, default: false]
  time_suspicious boolean [not null, default: false]
  is_corrected boolean [not null, default: false]
  id_created_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_user, work_date) [name: 'attendance_user_date_idx']
    work_date [name: 'attendance_date_idx']
    status [name: 'attendance_status_idx']
  }
}

table audit_events {
  id_audit integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  type text [not null]
  id_actor integer
  id_worker integer
  sale_uuid uuid
  payload jsonb [not null, default: `{}`]
  occurred_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    occurred_at [name: 'audit_events_occurred_idx']
    (id_worker, type, occurred_at) [name: 'audit_events_worker_type_idx']
  }
}

table cash_movements {
  id_cash_movement integer [pk, not null]
  uuid uuid [not null, unique]
  shift_uuid uuid [not null]
  type cash_movement_type [not null]
  amount "numeric(10, 2)" [not null]
  reason text [not null]
  occurred_at "timestamp with time zone" [not null]
  id_created_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    shift_uuid [name: 'cash_movements_shift_idx']
  }
}

table cash_shifts {
  id_shift integer [pk, not null]
  uuid uuid [not null, unique]
  id_cashier integer [not null]
  status cash_shift_status [not null, default: 'open']
  opened_at "timestamp with time zone" [not null]
  opening_cash "numeric(10, 2)" [not null]
  closed_at "timestamp with time zone"
  counted_cash "numeric(10, 2)"
  counted_yape "numeric(10, 2)"
  counted_card "numeric(10, 2)"
  close_note text
  reported_sales integer
  expected_cash "numeric(10, 2)"
  expected_yape "numeric(10, 2)"
  expected_card "numeric(10, 2)"
  id_reviewed_by integer
  reviewed_at "timestamp with time zone"
  review_note text
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_cashier, status) [name: 'cash_shifts_cashier_status_idx']
    opened_at [name: 'cash_shifts_opened_idx']
  }
}

table categories {
  id_category integer [pk, not null]
  name text [not null]
  icon text
  sort_order integer [not null, default: 0]
  tracks_expiry boolean [not null, default: false]
  expiry_warning_days integer [not null, default: 30]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    name [name: 'categories_name_lower_unique', unique]
  }
}

table discount_policies {
  id_policy integer [pk, not null]
  discount_percent "numeric(5, 2)" [not null, default: '0']
  max_discounted_sales_per_day integer [not null]
  max_discount_per_month "numeric(10, 2)" [not null, default: '0']
  max_discounted_units_per_sale integer [not null, default: 3]
  birthday_gift_max_amount "numeric(10, 2)" [not null, default: '0']
  points_per_sol "numeric(5, 2)" [not null]
  is_active boolean [not null, default: true]
  created_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table goods_receipt_items {
  id_receipt_item integer [pk, not null]
  id_receipt integer [not null]
  id_product integer [not null]
  id_presentation integer
  quantity integer [not null]
  units integer [not null]
  received_units integer [not null]
  line_total "numeric(10, 2)" [not null]
  unit_cost "numeric(12, 4)" [not null]
  is_bonus boolean [not null, default: false]
  expires_at date
  capture_source capture_source

  indexes {
    
    id_receipt [name: 'goods_receipt_items_receipt_idx']
  }
}

table goods_receipts {
  id_receipt integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  id_supplier integer
  id_order integer
  id_location integer [not null]
  doc_type receipt_doc_type [not null, default: 'ninguno']
  doc_number text
  total "numeric(10, 2)" [not null]
  note text
  id_created_by integer
  received_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_supplier, doc_type, doc_number) [name: 'goods_receipts_document_unique', unique]
    received_at [name: 'goods_receipts_received_idx']
  }
}

table locations {
  id_location integer [pk, not null]
  name text [not null, unique]
  kind location_kind [not null]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table loyalty_ledger {
  id_loyalty integer [pk, not null]
  id_worker integer [not null]
  id_sale integer [unique]
  points integer [not null]
  type loyalty_movement_type [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    id_worker [name: 'loyalty_ledger_worker_idx']
  }
}

table product_presentations {
  id_presentation integer [pk, not null]
  id_product integer [not null]
  name text [not null]
  id_parent_presentation integer
  qty_of_parent integer [not null]
  units_total integer [not null]
  barcode text [unique]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    
    (id_product, name) [name: 'product_presentations_name_unique', unique]
  }
}

table products {
  id_product integer [pk, not null]
  sku text [unique]
  barcode text [unique]
  name text [not null]
  description text
  id_category integer [not null]
  price_sale "numeric(10, 2)" [not null]
  worker_discount_amount "numeric(10, 2)" [not null, default: '0']
  price_cost "numeric(12, 4)"
  stock_quantity integer
  track_stock boolean [not null, default: false]
  tracks_expiry boolean
  image_url text
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    id_category [name: 'products_category_id_idx']
  }
}

table purchase_order_items {
  id_order_item integer [pk, not null]
  id_order integer [not null]
  id_product integer [not null]
  id_presentation integer
  quantity integer [not null]
  units integer [not null]
  estimated_total "numeric(10, 2)"

  indexes {
    
    id_order [name: 'purchase_order_items_order_idx']
  }
}

table purchase_orders {
  id_order integer [pk, not null]
  id_supplier integer [not null]
  status purchase_order_status [not null, default: 'pending']
  expected_at date
  estimated_total "numeric(10, 2)"
  note text
  id_created_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    status [name: 'purchase_orders_status_idx']
  }
}

table receipt_discrepancies {
  id_discrepancy integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  id_receipt integer [not null]
  id_receipt_item integer [not null]
  id_product integer [not null]
  units integer [not null]
  amount "numeric(10, 2)" [not null]
  status discrepancy_status [not null, default: 'open']
  resolution_note text
  id_resolved_by integer
  resolved_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    
    status [name: 'receipt_discrepancies_status_idx']
  }
}

table sale_items {
  id_sale_item integer [pk, not null]
  id_sale integer [not null]
  id_product integer [not null]
  product_name text [not null]
  unit_price "numeric(10, 2)" [not null]
  quantity integer [not null]
  line_total "numeric(10, 2)" [not null]
  discount_percent "numeric(5, 2)" [not null, default: '0']
  discount_unit_amount "numeric(10, 2)" [not null, default: '0']
  discount_amount "numeric(10, 2)" [not null, default: '0']
  is_courtesy boolean [not null, default: false]
  unit_cost "numeric(12, 4)"
  capture_source capture_source
}

table sales {
  id_sale integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  id_cashier integer [not null]
  status sale_status [not null, default: 'completed']
  payment_type payment_type [not null]
  subtotal "numeric(10, 2)" [not null]
  discount_total "numeric(10, 2)" [not null, default: '0']
  discount_percent "numeric(5, 2)" [not null, default: '0']
  total "numeric(10, 2)" [not null]
  courtesy_total "numeric(10, 2)" [not null, default: '0']
  courtesy_approved_by integer
  id_worker integer
  id_policy integer
  worker_verification worker_verification [not null, default: 'none']
  points_earned integer [not null, default: 0]
  audit_flags text[] [not null, default: `'{}'::text[]`]
  shift_uuid uuid
  client_created_at "timestamp with time zone" [not null]
  synced_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    client_created_at [name: 'sales_client_created_at_idx']
    (id_worker, client_created_at) [name: 'sales_worker_created_idx']
    (id_cashier, client_created_at) [name: 'sales_cashier_created_idx']
    shift_uuid [name: 'sales_shift_idx']
  }
}

table sessions {
  session_token text [pk, not null]
  id_user integer [not null]
  expires "timestamp with time zone" [not null]
}

table stock_count_items {
  id_count_item integer [pk, not null]
  id_count integer [not null]
  id_product integer [not null]
  expected integer [not null]
  counted integer [not null]
  lots jsonb [not null, default: `[]`]
  status count_item_status [not null]
  id_reviewed_by integer
  reviewed_at "timestamp with time zone"
  review_note text
  capture_source capture_source

  indexes {
    status [name: 'stock_count_items_status_idx']
    id_product [name: 'stock_count_items_product_idx']
  }
}

table stock_counts {
  id_count integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  id_location integer [not null]
  id_counted_by integer
  counted_at "timestamp with time zone" [not null, default: `now()`]
}

table stock_levels {
  id_product integer [not null]
  id_location integer [not null]
  quantity integer [not null, default: 0]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_product, id_location) [pk]
  }
}

table stock_lots {
  id_lot integer [pk, not null]
  id_product integer [not null]
  id_location integer [not null]
  expires_at date [not null]
  quantity integer [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_product, id_location, expires_at) [name: 'stock_lots_product_location_expiry_unique', unique]
    expires_at [name: 'stock_lots_expires_idx']
  }
}

table stock_movements {
  id_movement integer [pk, not null]
  id_product integer [not null]
  id_location integer [not null]
  qty_delta integer [not null]
  balance_after integer [not null]
  type stock_movement_type [not null]
  ref_id uuid [not null]
  unit_cost "numeric(12, 4)"
  note text
  id_actor integer
  occurred_at "timestamp with time zone" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (type, ref_id, id_product, id_location) [name: 'stock_movements_ref_unique', unique]
    (id_product, created_at) [name: 'stock_movements_product_idx']
  }
}

table stock_transfer_items {
  id_transfer_item integer [pk, not null]
  id_transfer integer [not null]
  id_product integer [not null]
  units integer [not null]
  capture_source capture_source
}

table stock_transfers {
  id_transfer integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  id_from_location integer [not null]
  id_to_location integer [not null]
  note text
  id_created_by integer
  created_at "timestamp with time zone" [not null, default: `now()`]
}

table supplier_categories {
  id_supplier integer [not null]
  id_category integer [not null]

  indexes {
    (id_supplier, id_category) [pk]
    id_category [name: 'supplier_categories_category_idx']
  }
}

table suppliers {
  id_supplier integer [pk, not null]
  ruc text [unique]
  business_name text [not null]
  trade_name text
  contact_name text
  phone text
  email text
  address text
  notes text
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table users {
  id_user integer [pk, not null]
  name text [not null]
  username text [not null, unique]
  password_hash text [not null]
  role user_role [not null]
  is_active boolean [not null, default: true]
  email text [unique]
  email_verified "timestamp with time zone"
  image text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table verification_tokens {
  identifier text [not null]
  token text [not null]
  expires "timestamp with time zone" [not null]

  indexes {
    (identifier, token) [pk]
  }
}

table work_schedules {
  id_work_schedule integer [pk, not null]
  id_user integer [not null]
  weekday integer [not null]
  start_time time [not null]
  end_time time [not null]
  tolerance_min integer [not null, default: 10]
  id_updated_by integer
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id_user, weekday) [name: 'work_schedules_user_weekday_idx', unique]
  }
}

table workers {
  id_worker integer [pk, not null]
  uuid uuid [not null, unique, default: `gen_random_uuid()`]
  dni text [not null, unique]
  full_name text [not null]
  name_source worker_name_source [not null]
  company text [not null]
  birth_date date
  status worker_status [not null, default: 'pending']
  pending_reason worker_pending_reason [default: 'new']
  points_balance integer [not null, default: 0]
  registered_by integer
  approved_by integer
  approved_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    status [name: 'workers_status_idx']
  }
}

ref accounts_id_user_users_id_user_fk: accounts.id_user > users.id_user [delete: cascade, update: no action]

ref attendance_corrections_id_requested_by_users_id_user_fk: attendance_corrections.id_requested_by > users.id_user [delete: no action, update: no action]

ref attendance_corrections_id_reviewed_by_users_id_user_fk: attendance_corrections.id_reviewed_by > users.id_user [delete: no action, update: no action]

ref attendance_records_id_user_users_id_user_fk: attendance_records.id_user > users.id_user [delete: no action, update: no action]

ref attendance_records_id_created_by_users_id_user_fk: attendance_records.id_created_by > users.id_user [delete: no action, update: no action]

ref audit_events_id_actor_users_id_user_fk: audit_events.id_actor > users.id_user [delete: no action, update: no action]

ref audit_events_id_worker_workers_id_worker_fk: audit_events.id_worker > workers.id_worker [delete: no action, update: no action]

ref cash_movements_id_created_by_users_id_user_fk: cash_movements.id_created_by > users.id_user [delete: no action, update: no action]

ref cash_shifts_id_cashier_users_id_user_fk: cash_shifts.id_cashier > users.id_user [delete: no action, update: no action]

ref cash_shifts_id_reviewed_by_users_id_user_fk: cash_shifts.id_reviewed_by > users.id_user [delete: no action, update: no action]

ref discount_policies_created_by_users_id_user_fk: discount_policies.created_by > users.id_user [delete: no action, update: no action]

ref goods_receipt_items_id_receipt_goods_receipts_id_receipt_fk: goods_receipt_items.id_receipt > goods_receipts.id_receipt [delete: cascade, update: no action]

ref goods_receipt_items_id_product_products_id_product_fk: goods_receipt_items.id_product > products.id_product [delete: no action, update: no action]

ref goods_receipt_items_presentation_fk: goods_receipt_items.id_presentation > product_presentations.id_presentation [delete: no action, update: no action]

ref goods_receipts_id_supplier_suppliers_id_supplier_fk: goods_receipts.id_supplier > suppliers.id_supplier [delete: no action, update: no action]

ref goods_receipts_id_order_purchase_orders_id_order_fk: goods_receipts.id_order > purchase_orders.id_order [delete: no action, update: no action]

ref goods_receipts_id_location_locations_id_location_fk: goods_receipts.id_location > locations.id_location [delete: no action, update: no action]

ref goods_receipts_id_created_by_users_id_user_fk: goods_receipts.id_created_by > users.id_user [delete: no action, update: no action]

ref loyalty_ledger_id_worker_workers_id_worker_fk: loyalty_ledger.id_worker > workers.id_worker [delete: no action, update: no action]

ref loyalty_ledger_id_sale_sales_id_sale_fk: loyalty_ledger.id_sale > sales.id_sale [delete: no action, update: no action]

ref product_presentations_id_product_products_id_product_fk: product_presentations.id_product > products.id_product [delete: no action, update: no action]

ref product_presentations_parent_fk: product_presentations.id_parent_presentation > product_presentations.id_presentation [delete: no action, update: no action]

ref products_id_category_categories_id_category_fk: products.id_category > categories.id_category [delete: no action, update: no action]

ref purchase_order_items_id_order_purchase_orders_id_order_fk: purchase_order_items.id_order > purchase_orders.id_order [delete: cascade, update: no action]

ref purchase_order_items_id_product_products_id_product_fk: purchase_order_items.id_product > products.id_product [delete: no action, update: no action]

ref purchase_order_items_presentation_fk: purchase_order_items.id_presentation > product_presentations.id_presentation [delete: no action, update: no action]

ref purchase_orders_id_supplier_suppliers_id_supplier_fk: purchase_orders.id_supplier > suppliers.id_supplier [delete: no action, update: no action]

ref purchase_orders_id_created_by_users_id_user_fk: purchase_orders.id_created_by > users.id_user [delete: no action, update: no action]

ref receipt_discrepancies_id_receipt_goods_receipts_id_receipt_fk: receipt_discrepancies.id_receipt > goods_receipts.id_receipt [delete: cascade, update: no action]

ref receipt_discrepancies_id_product_products_id_product_fk: receipt_discrepancies.id_product > products.id_product [delete: no action, update: no action]

ref receipt_discrepancies_id_resolved_by_users_id_user_fk: receipt_discrepancies.id_resolved_by > users.id_user [delete: no action, update: no action]

ref receipt_discrepancies_item_fk: receipt_discrepancies.id_receipt_item > goods_receipt_items.id_receipt_item [delete: cascade, update: no action]

ref sale_items_id_sale_sales_id_sale_fk: sale_items.id_sale > sales.id_sale [delete: cascade, update: no action]

ref sale_items_id_product_products_id_product_fk: sale_items.id_product > products.id_product [delete: no action, update: no action]

ref sales_id_cashier_users_id_user_fk: sales.id_cashier > users.id_user [delete: no action, update: no action]

ref sales_courtesy_approved_by_users_id_user_fk: sales.courtesy_approved_by > users.id_user [delete: no action, update: no action]

