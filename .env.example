# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# En tu PC usa SIEMPRE los valores de QA. Los de producción solo van en Vercel (Production).

# --- Base de datos (Supabase) ---
# App: "Transaction pooler" (puerto 6543).
DATABASE_URL=
# Migraciones (pnpm db:migrate): "Session pooler" (puerto 5432). Opcional; si falta, usa DATABASE_URL.
MIGRATIONS_DATABASE_URL=
# Conexiones por instancia (opcional, 5 por defecto).
DB_POOL_MAX=

# --- Autenticación (next-auth) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Almacenamiento de imágenes (Supabase Storage, protocolo S3) ---
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=assets

# --- Búsqueda de DNI/RUC: sunat (por defecto), mock o none ---
DNI_PROVIDER=

# --- Bot de WhatsApp (opcional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
